# Only for a local run or Docker (npm start). On Cloudflare, use .dev.vars.example and wrangler.toml.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
FAMILY_MEMBERS=
WAKE_WORDS=בוט,עוזר,bot
DIGEST_TIME=07:30
CLAUDE_MODEL=claude-sonnet-5-5
MAX_DAILY_CALLS=300
WEB_SEARCH=true
GROUP_CONTEXT=15
HOUSE_TZ=Asia/Jerusalem
DB_PATH=/data/house.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
# Needed on Node for /calendar (the Google sign-in comes back to <PUBLIC_URL>/google/callback; long polling has no web server,
# so connect through the Worker)
PUBLIC_URL=
